{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@0.0.84"]
    },
    "angular-cli": {
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/frontend/node_modules/@angular/cli/bin/ng.js",
        "mcp",
        "--read-only"
      ]
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
